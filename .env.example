# -------------------------------------------------------------
# AI Token Checkin Workers 环境变量配置模板
# 复制本文件为 .env 并在本地填入您部署的 Worker 域名与密钥
# ⚠️ 注意：.env 文件已被 .gitignore 忽略，切勿提交至公开仓库
# -------------------------------------------------------------

# 网络代理（适用于国内直连 Cloudflare workers.dev 遇到困难的情况）
PROXY=http://127.0.0.1:7897

# 1. MiniMax Code
MINIMAX_WORKER_URL=https://minimax-daily-credits.your-subdomain.workers.dev
MINIMAX_ADMIN_KEY=your_minimax_secret_key

# 2. Trae CN (字节跳动)
TRAE_WORKER_URL=https://trae-daily-credits.your-subdomain.workers.dev
TRAE_ADMIN_KEY=your_trae_secret_key

# 3. Qoder CN
QODER_WORKER_URL=https://qoder-daily-credits.your-subdomain.workers.dev
QODER_ADMIN_KEY=your_qoder_secret_key

# 4. WorkBuddy (腾讯)
WORKBUDDY_WORKER_URL=https://wb-checkin.your-subdomain.workers.dev
WORKBUDDY_ADMIN_KEY=your_workbuddy_secret_key
